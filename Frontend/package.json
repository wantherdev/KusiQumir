{
  "name": "kusiqumir-page",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm frontend:start",
    "frontend:start": "ng serve --host 0.0.0.0 --port 4200 --allowed-hosts",
    "frontend:build": "ng build",
    "frontend:watch": "ng build --watch --configuration development",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check \"src/**/*.{ts,html}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html}\"",
    "frontend:test": "ng test",
    "backend:start": "cd backend && pnpm start:dev",
    "backend:build": "cd backend && pnpm build",
    "backend:prisma:generate": "cd backend && pnpm prisma generate",
    "backend:prisma:studio": "cd backend && pnpm prisma studio",
    "backend:prisma:seed": "cd backend && pnpm prisma db seed",
    "serve:ssr:kusiqumir_page": "node dist/kusiqumir_page/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",

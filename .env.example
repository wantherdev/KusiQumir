# ──────────────────────────────────────────────
# Kusi Q'umir — Variables de entorno (producción)
# Copia este archivo como .env y completa los valores
# ──────────────────────────────────────────────

# Postgres
POSTGRES_USER=kusiqumir
POSTGRES_PASSWORD=changeme_strong_password_here
PGPASSWORD=${POSTGRES_PASSWORD}

# Backend
JWT_SECRET=changeme_jwt_secret_min_16_chars
JWT_EXPIRES_IN=1h
CSRF_SECRET=changeme_csrf_secret_min_16_chars  # Debe pasarse al backend service env
CORS_ORIGIN=https://kusiqumir.com,https://www.kusiqumir.com
WHATSAPP_PHONE=51999000000
SENTRY_DSN=

# Frontend
API_URL=

# Monitoring
GRAFANA_PASSWORD=changeme_grafana_password

# CDN
CLOUDFRONT_DISTRIBUTION_ID=

# Retention
RETENTION_DAYS=7

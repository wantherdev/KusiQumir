NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://usuario:password@localhost:5432/kusiqumir"

# Seguridad — CAMBIA ESTOS VALORES EN PRODUCCIÓN
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE=604800000
CSRF_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
CSRF_SKIP_PATHS="auth/csrf,auth/login,auth/register,health"
CSRF_SECURE=false
CORS_ORIGIN="http://localhost:4200,https://kusiqumir.com"

# WhatsApp / Notificaciones
WHATSAPP_PHONE="51999000000"
NOTIFICATIONS_ENABLED=false

# Configuración regional
DEFAULT_NATIONALITY=PE
COMMISSION_RATE=0.12

# Prisma (retry)
PRISMA_MAX_RETRIES=3
PRISMA_RETRY_DELAY=1000

# Sentry (opcional — dejar vacío para deshabilitar)
SENTRY_DSN=

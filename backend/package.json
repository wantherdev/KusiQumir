{
  "name": "kusiqumir-page-backend",
  "version": "0.1.0",
  "description": "Backend inicial para la agencia de viajes digital",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "npx prisma migrate deploy && node dist/main",
    "prisma:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev --name init --skip-seed",
    "db:reset": "pnpm exec prisma migrate reset --force",
    "db:seed": "pnpm exec prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest-e2e.json",
    "test:all": "jest && jest --config jest-e2e.json"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.66.0",
    "@sentry/profiling-node": "^10.66.0",
    "@types/compression": "^1.8.1",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^4.22.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "multer": "^1.4.4",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.1.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}

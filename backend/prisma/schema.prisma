generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  Easy
  Moderate
  Challenging
}

enum GroupType {
  Shared
  Private
}

enum ServiceType {
  HalfDay
  FullDay
  MultiDay
}

model Role {
  id    String  @id @default(cuid())
  name  String  @unique
  users User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
}

model Customer {
  id           String                 @id @default(cuid())
  name         String
  email        String                 @unique
  nationality  String?
  passport     String?
  phone        String?
  preferences  String?
  createdAt    DateTime               @default(now())
  bookings     Booking[]
  acceptances  DocumentAcceptance[]
  invoices     Invoice[]
}

model Provider {
  id         String   @id @default(cuid())
  name       String
  type       String
  contact    String
  contract   String?
  commission String?
  services   String?
  createdAt  DateTime @default(now())
  tours      Tour[]
}

model Guide {
  id           String   @id @default(cuid())
  name         String
  languages    String
  credential   String
  availability Boolean  @default(true)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  operations   Operation[]
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  tours       Tour[]
}

model Tour {
  id               String         @id @default(cuid())
  slug             String         @unique
  code             String         @unique
  title            String
  subtitle         String?
  shortDescription String
  description      String
  durationHours    Int
  durationDays     Int
  difficulty       Difficulty
  groupType        GroupType
  serviceType      ServiceType
  featured         Boolean        @default(false)
  active           Boolean        @default(true)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])

  providerId       String?
  provider         Provider?      @relation(fields: [providerId], references: [id])
  packages         Package[]
  bookings         Booking[]
  experiences      Experience[]

  schedules        TourSchedule[]
  itineraryDays    ItineraryDay[]
  destinations     TourDestination[]
  includes         TourInclude[]
  excludes         TourExclude[]
  faqs             TourFaq[]
  recommendations  TourRecommendation[]
  requirements     TourRequirement[]
  prices           TourPrice[]
  images           TourImage[]
  seo              TourSeo?
  metadata         TourMetadata?
  reviews          Review[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Destination {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  tours       TourDestination[]
}

model TourDestination {
  id            String      @id @default(cuid())
  tourId        String
  destinationId String
  sortOrder     Int
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id])
}

model ItineraryDay {
  id        String              @id @default(cuid())
  day       Int
  title     String
  tourId    String
  tour      Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]
}

model ItineraryActivity {
  id              String       @id @default(cuid())
  itineraryDayId  String
  sortOrder       Int
  time            String?
  title           String
  description     String
  duration        Int
  itineraryDay    ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
}

model TourFaq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int
  tourId    String
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourImage {
  id       String  @id @default(cuid())
  url      String
  alt      String
  featured Boolean @default(false)
  sortOrder Int
  source   String?
  tourId   String
  tour     Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourPrice {
  id       String   @id @default(cuid())
  name     String
  currency String
  adult    Decimal
  child    Decimal?
  private  Decimal?
  tourId   String
  tour     Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourSchedule {
  id          String  @id @default(cuid())
  departure   String
  pickupStart String
  arrival     String
  language    String?
  available   Boolean @default(true)
  tourId      String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourInclude {
  id          String  @id @default(cuid())
  title       String
  description String?
  tourId      String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourExclude {
  id          String  @id @default(cuid())
  title       String
  description String?
  tourId      String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourRecommendation {
  id          String @id @default(cuid())
  title       String
  description String
  tourId      String
  tour        Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourRequirement {
  id          String @id @default(cuid())
  requirement String
  tourId      String
  tour        Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourSeo {
  id          String   @id @default(cuid())
  title       String
  description String
  keywords    Json?
  canonical   String?
  tourId      String   @unique
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourMetadata {
  id          String    @id @default(cuid())
  provider    String?
  sourceUrl   String?
  lastUpdated DateTime?
  tourId      String    @unique
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  name      String?
  country   String?
  createdAt DateTime @default(now())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  imageAlt    String?
  category    String?
  tags        String?
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Experience {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  content     String
  coverImage  String?
  imageAlt    String?
  location    String?
  duration    String?
  tourId      String?
  tour        Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([featured, sortOrder])
  @@index([location])
}

model Package {
  id           String    @id @default(cuid())
  name         String
  description  String
  price        Float
  featured     Boolean   @default(false)
  durationDays Int?
  discount     Float?
  imageUrl     String?
  included     String?
  excluded     String?
  tours        Tour[]
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

model Booking {
  id            String    @id @default(cuid())
  customerId    String
  tourId        String?
  packageId     String?
  travelers     Int
  status        String    @default("PENDIENTE")
  date          DateTime  @default(now())
  total         Float?
  unitPrice     Float?
  customerName  String?
  customerEmail String?
  customerPhone String?
  startDate     DateTime?
  notes         String?
  canceledAt    DateTime?
  customer      Customer  @relation(fields: [customerId], references: [id])
  tour          Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)
  package       Package?  @relation(fields: [packageId], references: [id])
  payment       Payment?
  operation     Operation?
  invoice       Invoice?

  @@index([customerId, date])
  @@index([status, date])
  @@index([date])
}

model Payment {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  amount     Float
  currency   String
  method     String?
  status     String   @default("PENDIENTE")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([status, createdAt])
}

model Operation {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  guideId    String?
  guide      Guide?   @relation(fields: [guideId], references: [id])
  transport  String
  pickupTime String
  status     String   @default("Confirmado")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
}

model Invoice {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  amount     Float
  currency   String
  status     String   @default("GENERADA")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Document {
  id          String                 @id @default(cuid())
  title       String
  version     String
  type        String?
  createdAt   DateTime               @default(now())
  acceptances DocumentAcceptance[]
}

model DocumentAcceptance {
  id         String   @id @default(cuid())
  documentId String
  customerId String
  ip         String
  version    String
  acceptedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  message   String
  status    String   @default("sent")
  sentAt    DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String  @id @default(cuid())
  name  String  @unique
  users User[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
}

model Customer {
  id           String                 @id @default(cuid())
  name         String
  email        String                 @unique
  nationality  String?
  passport     String?
  phone        String?
  preferences  String?
  createdAt    DateTime               @default(now())
  bookings     Booking[]
  acceptances  DocumentAcceptance[]
  invoices     Invoice[]
}

model Provider {
  id         String   @id @default(cuid())
  name       String
  type       String
  contact    String
  contract   String?
  commission String?
  services   String?
  createdAt  DateTime @default(now())
  tours      Tour[]
}

model Guide {
  id           String   @id @default(cuid())
  name         String
  languages    String
  credential   String
  availability Boolean  @default(true)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  operations   Operation[]
}

model Tour {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  subtitle         String?
  shortDescription String?  @db.Text
  description      String   @db.Text

  category         String
  tourType         String

  durationDays     Int
  durationHours    Int
  durationText     String

  country          String
  region           String
  city             String

  meetingPoint     String?
  endingPoint      String?

  pickup           Boolean @default(false)

  startTime        String?
  endTime          String?

  difficulty       String?

  altitudeMin      Int?
  altitudeMax      Int?

  groupType        String?

  featured         Boolean @default(false)
  status           String  @default("published")

  coverImage       String?
  video            String?

  currency         String @default("USD")
  adultPrice       Float?
  childPrice       Float?
  discount         Float?

  seoTitle         String?
  seoDescription   String? @db.Text
  seoKeywords      Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  languages        TourLanguage[]
  highlights       Highlight[]
  itinerary        Itinerary[]
  destinations     Destination[]
  includes         Include[]
  notIncludes      NotInclude[]
  recommendations  Recommendation[]
  requirements     Requirement[]
  whatToBring      WhatToBring[]
  faqs             FAQItem[]
  images           Image[]

  providerId       String?
  provider         Provider? @relation(fields: [providerId], references: [id])
  packages         Package[]
  bookings         Booking[]
  experiences      Experience[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([country])
  @@index([category])
}

model TourLanguage {
  id       String @id @default(cuid())
  language String

  tourId   String
  tour     Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
}

model Highlight {
  id          String @id @default(cuid())
  title       String
  description String?
  icon        String?

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Itinerary {
  id          String @id @default(cuid())
  day         Int
  order       Int
  time        String?
  title       String
  description String @db.Text
  location    String?
  duration    Int?

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([tourId, day])
}

model Destination {
  id          String @id @default(cuid())
  name        String
  type        String?
  description String? @db.Text

  latitude    Float?
  longitude   Float?

  altitude    Int?
  visitTime   Int?

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  images      DestinationImage[]

  @@index([tourId])
}

model DestinationImage {
  id            String @id @default(cuid())
  imageUrl      String
  alt           String?

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Include {
  id          String @id @default(cuid())
  title       String
  description String?

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model NotInclude {
  id          String @id @default(cuid())
  title       String
  description String?

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Recommendation {
  id          String @id @default(cuid())
  title       String?
  description String

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Requirement {
  id          String @id @default(cuid())
  requirement String

  tourId      String
  tour        Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model WhatToBring {
  id   String @id @default(cuid())
  item String

  tourId String
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model FAQItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text

  tourId   String
  tour     Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Image {
  id       String @id @default(cuid())
  url      String
  alt      String?
  featured Boolean @default(false)
  order    Int @default(0)

  tourId   String
  tour     Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  imageAlt    String?
  category    String?
  tags        String?
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Experience {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  content     String
  coverImage  String?
  imageAlt    String?
  location    String?
  duration    String?
  tourId      String?
  tour        Tour?     @relation(fields: [tourId], references: [id])
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([featured, sortOrder])
  @@index([location])
}

model Package {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Float
  featured    Boolean   @default(false)
  durationDays Int?
  discount    Float?
  imageUrl    String?
  included    String?
  excluded    String?
  tours       Tour[]
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id         String    @id @default(cuid())
  customerId String
  tourId     String?
  packageId  String?
  travelers  Int
  status     String    @default("PENDIENTE")
  date       DateTime  @default(now())
  total      Float?
  unitPrice  Float?
  customerName  String?
  customerEmail String?
  customerPhone String?
  startDate     DateTime?
  notes         String?
  canceledAt    DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])
  tour       Tour?     @relation(fields: [tourId], references: [id])
  package    Package?  @relation(fields: [packageId], references: [id])
  payment    Payment?
  operation  Operation?
  invoice    Invoice?

  @@index([customerId, date])
  @@index([status, date])
  @@index([date])
}

model Payment {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  amount     Float
  currency   String
  method     String?
  status     String   @default("PENDIENTE")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([status, createdAt])
}

model Operation {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  guideId    String?
  guide      Guide?   @relation(fields: [guideId], references: [id])
  transport  String
  pickupTime String
  status     String   @default("Confirmado")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
}

model Invoice {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  amount     Float
  currency   String
  status     String   @default("GENERADA")
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Document {
  id         String                 @id @default(cuid())
  title      String
  version    String
  type       String?
  createdAt  DateTime               @default(now())
  acceptances DocumentAcceptance[]
}

model DocumentAcceptance {
  id         String   @id @default(cuid())
  documentId String
  customerId String
  ip         String
  version    String
  acceptedAt DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  message   String
  status    String   @default("sent")
  sentAt    DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
}
